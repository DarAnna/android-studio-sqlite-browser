{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(scripts/e2e-check.sh:*)",
      "Bash(adb devices:*)",
      "Bash(adb forward:*)",
      "Bash(adb shell pidof:*)",
      "Bash(adb logcat:*)",
      "Bash(ktlint:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(curl -s http://localhost:8080/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ktlint-format.sh"
          }
        ]
      }
    ]
  }
}
